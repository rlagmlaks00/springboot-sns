# Default: auto-detect text files and normalize to LF
* text=auto eol=lf

# Shell scripts (must be LF)
*.sh text eol=lf
/gradlew text eol=lf

# Windows batch files (must be CRLF)
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
